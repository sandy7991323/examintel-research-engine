{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-source.schema.json",
  "title": "Research Source",
  "description": "Schema for a research source used to compose or verify exam study material, tracking provenance, type, and verification status.",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "Unique identifier for this source."
    },
    "source_type": {
      "type": "string",
      "description": "Category of the source.",
      "enum": [
        "university_official",
        "textbook",
        "research_paper",
        "educational_platform",
        "government",
        "technical_docs",
        "previous_paper",
        "model_paper"
      ]
    },
    "title": {
      "type": "string",
      "description": "Title of the source document or resource."
    },
    "url": {
      "type": "string",
      "description": "URL where the source can be accessed.",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "description": "Author or authoring organisation."
    },
    "publisher": {
      "type": "string",
      "description": "Publisher name."
    },
    "year": {
      "type": ["integer", "string"],
      "description": "Publication year or academic session."
    },
    "access_date": {
      "type": "string",
      "description": "ISO 8601 date when the source was last accessed.",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "description": "Whether the source content has been verified.",
      "enum": ["verified", "unverified", "unavailable"]
    },
    "relevance_notes": {
      "type": "string",
      "description": "Notes on why this source is relevant to the study material."
    },
    "content_summary": {
      "type": "string",
      "description": "Brief summary of the source content."
    }
  },
  "required": ["source_id", "source_type", "title"],
  "additionalProperties": false
}
